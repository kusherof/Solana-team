{
  "name": "glimmo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "anchor build && npm run idl:sync",
    "test": "bash scripts/test-local.sh",
    "test:unit": "cargo test -p glimmo --lib",
    "idl:sync": "cp target/idl/glimmo.json app/src/idl/glimmo.json && cp target/types/glimmo.ts app/src/idl/glimmo.ts",
    "devnet:init": "ts-node scripts/devnet-init.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.2",
    "bn.js": "5.2.2"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "ts-mocha": "10.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
