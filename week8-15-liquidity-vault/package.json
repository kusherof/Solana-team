{
  "name": "liquidity-vault",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "anchor build && npm run idl:sync",
    "build:devnet": "anchor build -- --features devnet && npm run idl:sync",
    "build:raydium-local": "bash scripts/build-raydium-clmm-local.sh",
    "test": "bash scripts/test-local.sh",
    "test:unit": "cargo test -p liquidity-vault --lib",
    "devnet:pool": "ts-node scripts/devnet/01-setup-pool.ts",
    "vault": "ts-node scripts/devnet/vault.ts",
    "idl:sync": "cp target/idl/liquidity_vault.json sdk/liquidity_vault_idl.json && cp target/types/liquidity_vault.ts sdk/liquidity_vault_types.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.2",
    "bn.js": "5.2.2",
    "decimal.js": "10.5.0"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "prettier": "3.5.3",
    "ts-mocha": "10.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}